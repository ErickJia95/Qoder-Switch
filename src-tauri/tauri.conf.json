{
  "productName": "Qoder Switch",
  "version": "2.2.0",
  "identifier": "com.qoder.proxy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "npx vue-tsc --noEmit && npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Qoder Switch",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
